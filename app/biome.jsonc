{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": true, "selfCloseVoidElements": "always" }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // release-please writes CHANGELOG.md; src-tauri is the Rust side (cargo
    // fmt); the Nuxt UI plugin writes src/components.d.ts and ts-rs writes
    // src/bindings.
    "includes": ["**", "!CHANGELOG.md", "!src-tauri", "!src/components.d.ts", "!src/bindings"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  // Biome's Markdown formatter drops the blank line before a list.
  "markdown": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    // The rules of the tests check the test files only: elsewhere they take
    // the `fit` of the popup for a focused test.
    "domains": { "test": "none" },
    "rules": {
      "preset": "recommended",
      // Nursery rules: a Biome update may rename them, which `biome migrate --write` follows.
      "nursery": {
        "noTailwindLegacyUtilities": "error",
        "noTailwindRawColors": "error",
        "useTailwindShorthandClasses": "error",
        "useTailwindStaticClassStrings": "error",
        "useTailwindVariablesShorthand": "error"
      }
    }
  },
  "overrides": [
    {
      // The `scope` of vue-i18n's <i18n-t> is a prop, not the table header
      // attribute this rule guards; the app has no data tables.
      "includes": ["**/*.vue"],
      "linter": { "rules": { "a11y": { "noHeaderScope": "off" } } }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": { "domains": { "test": "recommended" } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "operatorLinebreak": "before"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on"
      }
    }
  }
}
