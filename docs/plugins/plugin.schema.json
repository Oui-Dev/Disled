{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Oui-Dev/Disled/main/docs/plugins/plugin.schema.json",
  "title": "Disled plugin manifest",
  "description": "plugin.json, version 1 of the plugin API, as Disled 2.1 reads it (docs/plugins/manifest.md). The schema refuses the fields and values that the app ignores, which are typos most of the time.",
  "type": "object",
  "required": ["api", "id", "name", "version", "author", "description", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The address of this schema, for the editor."
    },
    "api": {
      "const": 2,
      "description": "The version of the plugin API: 2. Any other value makes the plugin unreadable."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "description": "A lowercase letter or digit, then up to 31 of them or dashes. The name of the folder of the plugin."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "The name that the windows show."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "The version of the plugin, in SemVer, such as 1.2.0."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Shown after \"by\"."
    },
    "icon": {
      "enum": [
        "terminal",
        "timer",
        "bot",
        "code",
        "git-branch",
        "calendar",
        "bell",
        "mail",
        "message-square",
        "music",
        "headphones",
        "coffee",
        "zap",
        "puzzle"
      ],
      "description": "The icon of the plugin, puzzle when there is none."
    },
    "description": {
      "$ref": "#/definitions/text300",
      "description": "What the plugin does, in plain text."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["run", "color", "alert", "events", "lamp"]
      },
      "anyOf": [{ "contains": { "const": "run" } }, { "contains": { "const": "events" } }],
      "description": "What the plugin can do, which the approval lists: at least run or events. lamp needs run."
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/state" },
      "description": "The states of the plugin, with color only. Their ids differ."
    },
    "idle": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "The id of the state shown when no key is alive, one of the states."
    },
    "events": { "$ref": "#/definitions/events" },
    "run": { "$ref": "#/definitions/run" },
    "note": { "$ref": "#/definitions/note" }
  },
  "allOf": [
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "color" } } } },
      "then": { "required": ["states"] },
      "else": { "not": { "anyOf": [{ "required": ["states"] }, { "required": ["idle"] }] } }
    },
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "events" } } } },
      "then": { "required": ["events"] },
      "else": { "not": { "required": ["events"] } }
    },
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "run" } } } },
      "then": { "required": ["run"] },
      "else": { "not": { "required": ["run"] } }
    },
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "lamp" } } } },
      "then": { "properties": { "capabilities": { "contains": { "const": "run" } } } }
    }
  ],
  "definitions": {
    "text40": {
      "description": "A text of 1 to 40 characters, or an object of them by language, such as { \"en\": \"…\", \"fr\": \"…\" }.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 40 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      ]
    },
    "text300": {
      "description": "A text of 1 to 300 characters, or an object of them by language.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 300 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      ]
    },
    "paragraphs": {
      "description": "Paragraphs of 1 to 500 characters each, or an object of them by language.",
      "oneOf": [
        { "$ref": "#/definitions/paragraphList" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/paragraphList" }
        }
      ]
    },
    "paragraphList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "state": {
      "type": "object",
      "required": ["id", "label", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "label": { "$ref": "#/definitions/text40" },
        "color": {
          "description": "Its default color, which the user can change: a built-in color, or a color of the plugin's own.",
          "oneOf": [
            { "enum": ["green", "orange", "red", "warm_white"] },
            {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "description": "A CIE 1931 chromaticity, x + y at most 1.",
              "properties": {
                "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                "y": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
              }
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "1 by default: the live key of the highest priority gives the state."
        },
        "ttl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Seconds a key keeps this state without a new event."
        }
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/.*)?$",
      "description": "A JSON pointer (RFC 6901), such as /session_id."
    },
    "scalar": { "type": ["string", "number", "boolean"] },
    "condition": {
      "oneOf": [
        { "$ref": "#/definitions/scalar" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/scalar" } },
        {
          "type": "object",
          "required": ["nonEmpty"],
          "additionalProperties": false,
          "properties": { "nonEmpty": { "type": "boolean" } }
        },
        {
          "type": "object",
          "required": ["exists"],
          "additionalProperties": false,
          "properties": { "exists": { "type": "boolean" } }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["when"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "$ref": "#/definitions/pointer" },
          "additionalProperties": { "$ref": "#/definitions/condition" }
        },
        "state": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "One of the states of the plugin."
        },
        "alert": { "type": "boolean" },
        "clear": { "type": "boolean" },
        "ignore": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["state"] },
        { "required": ["alert"], "properties": { "alert": { "const": true } } },
        { "required": ["clear"], "properties": { "clear": { "const": true } } },
        { "required": ["ignore"], "properties": { "ignore": { "const": true } } }
      ]
    },
    "events": {
      "type": "object",
      "required": ["from", "rules"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/definitions/text40" },
        "key": { "$ref": "#/definitions/pointer" },
        "rules": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": [{ "type": "string", "minLength": 1 }],
      "additionalItems": { "type": "string" },
      "description": "The program, then its arguments."
    },
    "run": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "The command for each system, else the default one. A system without either cannot run the plugin.",
      "properties": {
        "windows": { "$ref": "#/definitions/command" },
        "macos": { "$ref": "#/definitions/command" },
        "linux": { "$ref": "#/definitions/command" },
        "default": { "$ref": "#/definitions/command" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/definitions/paragraphs" },
        "file": { "type": "string", "minLength": 1, "maxLength": 64 },
        "block": {
          "description": "A text, or JSON that the window shows with 2 spaces of indentation: 16 KiB at most."
        }
      }
    }
  }
}
